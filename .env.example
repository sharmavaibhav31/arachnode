# =============================================================================
# JobHunter (Arachnode) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before running docker compose.
# NEVER commit .env to version control.

# =============================================================================
# SECURITY — Required for production
# =============================================================================

# API key for dashboard authentication.
# Leave blank for unauthenticated local development (default).
# For production, generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and set the value here.
JOBHUNTER_API_KEY=

# =============================================================================
# DATABASE — Change passwords before deploying
# =============================================================================
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=jobpass
POSTGRES_DB=jobsdb

# =============================================================================
# EXTERNAL SERVICES — Required for full functionality
# =============================================================================

# GitHub Personal Access Token — for scraping GitHub profiles during contact discovery.
# Create at: https://github.com/settings/tokens (read:user scope is sufficient)
GITHUB_TOKEN=ghp_replace_with_your_token

# Gmail address used to SEND cold emails via SMTP.
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password — NOT your regular password.
# Create at: https://myaccount.google.com/apppasswords
# Requires 2FA to be enabled on the account.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: separate address to RECEIVE the weekly digest.
# Defaults to GMAIL_ADDRESS if not set.
DIGEST_RECIPIENT_EMAIL=

# =============================================================================
# JOB SEEKER PROFILE — Customize for your search
# =============================================================================

YOUR_NAME=Applicant Name
YOUR_GITHUB_URL=https://github.com/yourusername

# Used by the Scrapy spiders to filter and rank job postings.
JOBSEEKER_ROLE=Backend Engineer
JOBSEEKER_STACK=Python,FastAPI,PostgreSQL,Redis,Go

# =============================================================================
# SYSTEM CONFIGURATION — Safe defaults; adjust as needed
# =============================================================================

# How often (in hours) to trigger the Scrapy crawl cycle.
CRAWL_INTERVAL_HOURS=8

# How often (in hours) to trigger contact discovery.
DISCOVER_INTERVAL_HOURS=24

# Seconds to wait after triggering scraper before counting new jobs.
# Increase if your network is slow or you have many spiders.
SCRAPER_WAIT_SECS=60

# Seconds to wait between contact discovery requests (per company).
# Lower = faster, higher = less likely to be rate-limited.
DISCOVER_DELAY_SECS=30

# Days since an email was sent before scheduling a follow-up.
FOLLOWUP_DAYS=7

# Host port the dashboard is exposed on.
GATEWAY_PORT=8080

# Ollama endpoint for LLM-powered email personalisation.
# If Ollama is running on your host machine, use host.docker.internal.
# Leave as-is if you're not using Ollama — the service falls back to templates.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# =============================================================================
# JOB SEARCH AGENT — LLM provider for intent parsing
# =============================================================================

# ollama is free and runs locally (default)
# openai / anthropic give more precise search strategies
AGENT_PROVIDER=ollama
AGENT_MODEL=mistral

# Optional paid providers (only needed if AGENT_PROVIDER is set to openai/anthropic)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# GEMINI AI AGENT — Optional, enables AI-powered job search and career tools
# =============================================================================
# Get a free API key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/minute, 1 million tokens/day
# Leave blank to disable — all other services work without this.
GEMINI_API_KEY=

# =============================================================================
# REFERRAL OUTREACH SERVICE
# =============================================================================
# Your name as it appears in outreach messages
REFERRAL_YOUR_NAME=Your Name

# Your tech stack (comma-separated) — used in message templates
REFERRAL_STACK=Python,FastAPI,React,Node.js,PostgreSQL

# Type of opportunities you're looking for
# Options: "full-time", "internship", "both full-time and internship"
REFERRAL_OPPORTUNITY_TYPE=both full-time and internship

# How many outreach messages to queue per day (max 15)
REFERRAL_DAILY_LIMIT=12


